{
  "name": "launchcraft",
  "displayName": "LaunchCraft",
  "description": "Stack-aware auto-generation of Docker, CI/CD, and deployment configs. Skip manual deployment setup",
  "version": "0.0.2",
  "icon": "assets/icon.png",
  "publisher": "navneet-anand",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/launchcraft"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:devlaunch.initialize"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devlaunch.initialize",
        "title": "DevLaunch: Initialize Deployment"
      }
    ]
  },
  "license": "MIT",
  "keywords": [
    "docker",
    "devops",
    "deployment",
    "jenkins",
    "railway"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
